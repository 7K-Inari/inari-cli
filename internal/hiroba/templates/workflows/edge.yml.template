name: edge
on: {push: {branches: [main]}}
permissions: {contents: read}
concurrency: {group: "hiroba-release-${{ github.repository }}", cancel-in-progress: false}
jobs:
  edge:
    uses: 7K-Hiroba/workflows/.github/workflows/edge.yml@__WORKFLOWS_V1_SHA__ # __WORKFLOWS_VERSION__
    with: {root: .}
    permissions: {contents: write, packages: write, id-token: write, attestations: write, actions: read, artifact-metadata: write}
