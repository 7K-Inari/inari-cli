name: chart repair
on:
  workflow_dispatch:
    inputs:
      chart: {required: true, type: string}
      version: {required: true, type: string}
permissions: {contents: read}
concurrency: {group: "hiroba-release-${{ github.repository }}", cancel-in-progress: false}
jobs:
  resolve:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs: {source-sha: "${{ steps.source.outputs.sha }}"}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: {path: consumer, fetch-depth: 0}
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: {repository: 7K-Hiroba/workflows, ref: __WORKFLOWS_V1_SHA__, path: .hiroba/workflows}
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
        with: {python-version: "3.11"}
      - run: pip install --requirement .hiroba/workflows/requirements-dev.txt
      - id: source
        env: {CHART: "${{ inputs.chart }}", VERSION: "${{ inputs.version }}"}
        run: |
          set -euo pipefail
          [[ "$CHART" =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 2
          [[ "$VERSION" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$ ]] || exit 2
          python3 .hiroba/workflows/scripts/discover-components.py --root consumer --all > plan.json
          release_component=$(jq -r --arg chart "$CHART" 'first(.components[] | select(.kind == "chart" and .name == $chart) | (.releaseComponent // .name)) // empty' plan.json)
          [[ -n "$release_component" ]] || { echo "chart $CHART is not declared" >&2; exit 2; }
          TAG="$release_component-v$VERSION"
          sha=$(git -C consumer ls-remote origin "refs/tags/$TAG^{}" | awk 'NR == 1 {print $1}')
          [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "repair requires an existing annotated tag $TAG" >&2; exit 2; }
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
  repair:
    needs: resolve
    uses: 7K-Hiroba/workflows/.github/workflows/release-chart.yml@__WORKFLOWS_V1_SHA__ # __WORKFLOWS_VERSION__
    with:
      root: .
      chart: "${{ inputs.chart }}"
      version: "${{ inputs.version }}"
      source-sha: "${{ needs.resolve.outputs.source-sha }}"
      repair: true
      standalone: true
    permissions: {contents: read, packages: write, id-token: write, attestations: write, actions: read, artifact-metadata: write}
